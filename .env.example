# Copy this file to ".env" and paste your own Gemini API key.
# Each developer uses their own key (independent free-tier quotas).
# The real .env is gitignored — never commit it.
GEMINI_API_KEY=

# ── Gemini thinking level (OPTIONAL — final evaluation) ─────────────────────
# Explicit Gemini ThinkingConfig.thinking_level for the Architect and the
# Reviewer ONLY (minimal|low|medium|high). The Clarifier, advisor, Ask-AI
# chat and repo ingestor have no seam and keep the provider default. Leave
# unset to preserve existing behavior exactly. Only valid on Google-routed
# calls — never combined with KI Connect routing. Recorded per step in the
# run trace (StepLog.thinking_level) so a run proves what it used.
# Final evaluation example:
# ARCHITECT_GEMINI_THINKING_LEVEL=high
# REVIEWER_GEMINI_THINKING_LEVEL=high

# ── KI Connect NRW experiment (OPTIONAL) ─────────────────────────────────
# Institution-funded OpenAI-compatible endpoint. Redirect only the role(s)
# being evaluated; other agents stay on their existing provider.
# KICONNECT_API_KEY=
# KICONNECT_BASE_URL=https://chat.kiconnect.nrw/api/v1
# KICONNECT_MAX_TOKENS=32000
# KICONNECT_TIMEOUT_SECONDS=180
# ARCHITECT_LLM_PROVIDER=kiconnect
# ARCHITECT_LLM_MODEL=OpenAI GPT OSS 120b KI:Inferenz.nrw
# REVIEWER_LLM_PROVIDER=kiconnect
# REVIEWER_LLM_MODEL=OpenAI GPT OSS 120b KI:Inferenz.nrw
