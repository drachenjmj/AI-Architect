{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reviewer Report",
  "description": "Rubric v2 report assembled in code from deterministic scores and binary LLM judgments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overall_status",
    "rubric_scores",
    "judgment_reasons",
    "issues",
    "requires_refinement",
    "refinement_instruction",
    "not_applicable"
  ],
  "properties": {
    "overall_status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "rubric_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_artifacts_present",
        "constraint_coverage",
        "traceability",
        "adr_presence",
        "repo_grounding",
        "flaw_detection",
        "adr_soundness",
        "best_practice_grounding",
        "refinement_readiness"
      ],
      "properties": {
        "all_artifacts_present": { "type": "integer", "minimum": 0, "maximum": 2 },
        "constraint_coverage": { "type": "integer", "minimum": 0, "maximum": 2 },
        "traceability": { "type": "integer", "minimum": 0, "maximum": 2 },
        "adr_presence": { "type": "integer", "minimum": 0, "maximum": 2 },
        "repo_grounding": { "type": "boolean" },
        "flaw_detection": { "type": "boolean" },
        "adr_soundness": { "type": "boolean" },
        "best_practice_grounding": { "type": "boolean" },
        "refinement_readiness": { "type": "boolean" }
      }
    },
    "judgment_reasons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_grounding",
        "flaw_detection",
        "adr_soundness",
        "best_practice_grounding",
        "refinement_readiness"
      ],
      "properties": {
        "repo_grounding": { "type": "string" },
        "flaw_detection": { "type": "string" },
        "adr_soundness": { "type": "string" },
        "best_practice_grounding": { "type": "string" },
        "refinement_readiness": { "type": "string" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "finding",
          "evidence",
          "suggested_fix",
          "requires_refinement"
        ],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "category": {
            "type": "string",
            "enum": [
              "completeness",
              "constraint",
              "grounding",
              "traceability",
              "adr",
              "repo_alignment",
              "safety"
            ]
          },
          "finding": { "type": "string" },
          "evidence": { "type": "string" },
          "suggested_fix": { "type": "string" },
          "requires_refinement": { "type": "boolean" }
        }
      }
    },
    "requires_refinement": {
      "type": "boolean",
      "description": "True unless every code item is full, every VERDICT-BEARING judgment passes, and no high-severity issue exists. Criteria listed in not_applicable, and refinement_readiness, are excluded from that test."
    },
    "refinement_instruction": {
      "type": "string",
      "description": "Code-assembled instruction carrying the finding, evidence and fix of every issue, ranked by severity; empty on pass."
    },
    "not_applicable": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Criteria asked and recorded but carrying no verdict weight, because no evidence existed for them to judge. Must render as n/a, never as a pass."
    }
  }
}
